# SachetSathi environment — copy to `.env` and fill in. NEVER commit `.env`.
# Keep comments on their own line: a value never contains a trailing comment.
# Every value is optional at scaffold stage; the app boots with safe defaults.

# --- app ---
# local | production
APP_ENV=local
# 1 = replay fixtures/, never hit the network (venue-wifi insurance)
DEMO_MODE=0
PORT=8000

# --- storage ---
# sqlite file + downloaded report photos live here
DATA_DIR=./data
# empty => sqlite:///./data/sachet.db
DATABASE_URL=

# --- telegram ---
# create a fresh bot with @BotFather; add it to your channel as an admin
TELEGRAM_BOT_TOKEN=
# e.g. -1001234567890 (or @your_channel_username); the digest is posted here
TELEGRAM_CHANNEL_ID=
# empty => https://api.telegram.org; set a relay only if the host blocks it
TELEGRAM_API_ROOT=

# --- gemma triage (Google Gemini API, open weights) ---
# key from Google AI Studio
GEMINI_API_KEY=
# confirm the id against the live model list before the demo
GEMMA_MODEL=gemma-4-26b-a4b-it

# --- external feeds ---
GDACS_RSS_URL=https://www.gdacs.org/xml/rss.xml
FEED_TIMEOUT_SECONDS=15
