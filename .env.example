# SachetSathi environment — copy to `.env` and fill in. NEVER commit `.env`.
# All values are optional at scaffold stage; the app boots with safe defaults.

# --- app ---
APP_ENV=local                  # local | production
DEMO_MODE=0                    # 1 = replay fixtures/, never hit the network (venue-wifi insurance)
PORT=8000

# --- storage ---
DATA_DIR=./data                # sqlite file + downloaded report photos live here
DATABASE_URL=                  # empty => sqlite:///./data/sachet.db

# --- telegram (create a fresh bot with @BotFather; reuse telegram-send-demo plumbing) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=           # e.g. -1001234567890 (channel the digest is posted to)

# --- gemma triage (Google Gemini API, open weights) ---
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it     # verify against the Gemini API model list before the demo

# --- external feeds ---
GDACS_RSS_URL=https://www.gdacs.org/xml/rss.xml
FEED_TIMEOUT_SECONDS=15
